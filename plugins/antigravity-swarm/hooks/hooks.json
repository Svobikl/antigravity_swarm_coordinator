{
  "antigravity-swarm": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ../scripts/asw-hook.mjs --event SessionStart",
        "timeout": 10,
        "statusMessage": "ASW: loading KV-cached EnvFacts micro-skills"
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ../scripts/asw-hook.mjs",
        "timeout": 10,
        "statusMessage": "ASW: routing workflow, TurnGuard, and Quad-Model subagent gates"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_to_file|multi_replace_file_content|write_file|edit_file|replace_file_content|run_command|apply_patch|Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/asw-lsp-check.mjs",
            "timeout": 60,
            "statusMessage": "ASW: diagnostics guidance hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../scripts/asw-stop-check.mjs",
        "timeout": 10,
        "statusMessage": "ASW: checking plan & subagent continuation"
      }
    ]
  }
}
